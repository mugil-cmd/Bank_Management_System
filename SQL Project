SELECT UPPER(CUSTOMER_NAME) FROM CUSTOMER;

SELECT LOWER(CUSTOMER_NAME) FROM CUSTOMER;

SELECT LENGTH(CUSTOMER_NAME) FROM CUSTOMER;

SELECT CUSTOMER_NAME,
SUBSTR(CUSTOMER_NAME, 1,4) AS SHORT_NAME
FROM CUSTOMER;

SELECT CUSTOMER_ID, BALANCE,
ROUND(BALANCE, -4) AS ROUNDED_BALANCE
FROM ACCOUNT;

SELECT CUSTOMER_ID, BALANCE,
MOD(BALANCE, 10000) AS REMAINDER
FROM ACCOUNT;

SELECT ACCOUNT_ID,
TO_CHAR(OPENING_DATE,'DD-MM-YYYY') AS OPENING_DATE
FROM ACCOUNT;

SELECT CUSTOMER_NAME,
NVL(EMAIL, 'NO EMAIL') AS EMAIL
FROM CUSTOMER;

SELECT COUNT(*) AS TOTAL_CUSTOMERS
FROM CUSTOMER;

SELECT COUNT(*) AS TOTAL_ACCOUNTS
FROM ACCOUNT;

SELECT
SUM(BALANCE) AS TOTAL_BALANCE,
AVG(BALANCE) AS AVERAGE_BALANCE,
MAX(BALANCE) AS HIGHEST_BALANCE,
MIN(BALANCE) AS LOWEST_BALANCE
FROM ACCOUNT;

SELECT CITY,
COUNT(*) AS CUSTOMER_COUNT
FROM CUSTOMER
GROUP BY CITY;

SELECT ACCOUNT_TYPE,
COUNT(*) AS ACCOUNT_COUNT
FROM ACCOUNT
GROUP BY ACCOUNT_TYPE;

SELECT ACCOUNT_TYPE,
SUM(BALANCE) AS TOTAL_BALANCE
FROM ACCOUNT
GROUP BY ACCOUNT_TYPE;

SELECT BRANCH_ID,
AVG(SALARY) AS AVERAGE_SALARY
FROM EMPLOYEE
GROUP BY BRANCH_ID;

SELECT ACCOUNT_TYPE,
SUM(BALANCE) AS TOTAL_BALANCE
FROM ACCOUNT
GROUP BY ACCOUNT_TYPE
HAVING SUM(BALANCE) >50000;


SELECT C.CUSTOMER_NAME,A.ACCOUNT_ID,A.BALANCE
FROM CUSTOMER C
INNER JOIN ACCOUNT A
ON C.CUSTOMER_ID=A.CUSTOMER_ID;

SELECT C.CUSTOMER_NAME,A.ACCOUNT_TYPE,B.BRANCH_NAME
FROM CUSTOMER C
INNER JOIN ACCOUNT A
ON C.CUSTOMER_ID=A.CUSTOMER_ID
INNER JOIN BRANCH B
ON B.BRANCH_ID=A.BRANCH_ID; 

SELECT E.EMPLOYEE_NAME,E.DESIGNATION,B.BRANCH_NAME
FROM EMPLOYEE E
INNER JOIN BRANCH B
ON E.BRANCH_ID=B.BRANCH_ID;

SELECT T.TRANSACTION_ID, T.ACCOUNT_ID, T.TRANSACTION_TYPE, T.AMOUNT, T.TRANSACTION_DATE
FROM BANK_TRANSACTION T
INNER JOIN ACCOUNT A
ON T.ACCOUNT_ID=A.ACCOUNT_ID;

SELECT C.CUSTOMER_ID,C.CUSTOMER_NAME,A.ACCOUNT_ID,A.BALANCE
FROM CUSTOMER C
LEFT JOIN ACCOUNT A
ON C.CUSTOMER_ID=A.CUSTOMER_ID;

SELECT B.BRANCH_ID,B.BRANCH_NAME,E.EMPLOYEE_NAME,E.DESIGNATION
FROM BRANCH B
LEFT OUTER JOIN EMPLOYEE E
ON B.BRANCH_ID=E.BRANCH_ID;

SELECT ACCOUNT_ID,BALANCE,
RANK() OVER(ORDER BY BALANCE DESC) AS BALANCE_RANK
FROM ACCOUNT;

SELECT ACCOUNT_ID,BALANCE,
ROW_NUMBER() OVER(ORDER BY BALANCE DESC) AS ROW_NUMBER
FROM ACCOUNT;

SELECT EMPLOYEE_ID,EMPLOYEE_NAME,BRANCH_ID,SALARY,
RANK() OVER(PARTITION BY BRANCH_ID ORDER BY SALARY DESC) AS SALARY_RANK
FROM EMPLOYEE;

SELECT TRANSACTION_ID,ACCOUNT_ID,AMOUNT,TRANSACTION_DATE,
SUM(AMOUNT) OVER(ORDER BY TRANSACTION_ID,TRANSACTION_DATE) AS RUNNING_TOTAL
FROM BANK_TRANSACTION;

SELECT TRANSACTION_ID,ACCOUNT_ID,AMOUNT,
LAG(AMOUNT) OVER(ORDER BY TRANSACTION_ID) AS PREVIOUS_SALARY
FROM BANK_TRANSACTION;

SELECT TRANSACTION_ID,ACCOUNT_ID,AMOUNT,
LEAD(AMOUNT) OVER(ORDER BY TRANSACTION_ID) AS NEXT_SALARY
FROM BANK_TRANSACTION;

WITH ACCOUNT_SUMMARY AS 
(
SELECT ACCOUNT_TYPE,
SUM(BALANCE) AS TOTAL_BALANCE
FROM ACCOUNT
GROUP BY ACCOUNT_TYPE
)
SELECT * FROM ACCOUNT_SUMMARY;

WITH TRANSACTION_SUMMARY AS
(
SELECT ACCOUNT_ID,
SUM(AMOUNT) AS TOTAL_AMOUNT
FROM BANK_TRANSACTION
GROUP BY ACCOUNT_ID
)
SELECT * FROM TRANSACTION_SUMMARY;

WITH EMPLOYEE_SALARY AS
(
SELECT BRANCH_ID,
AVG(SALARY) AS AVERAGE_SALARY
FROM  EMPLOYEE
GROUP BY BRANCH_ID
)
SELECT * FROM EMPLOYEE_SALARY;

WITH TRANSACTION_SUMMARY AS (
SELECT ACCOUNT_ID,
SUM(AMOUNT) AS TOTAL_TRANSACTION
FROM BANK_TRANSACTION
GROUP BY ACCOUNT_ID
)
SELECT C.CUSTOMER_NAME,
       A.ACCOUNT_ID,
       A.ACCOUNT_TYPE,
       A.BALANCE,
       NVL(T.TOTAL_TRANSACTION, 0) AS TOTAL_TRANSACTION
FROM CUSTOMER C
JOIN ACCOUNT A
ON C.CUSTOMER_ID = A.CUSTOMER_ID
LEFT JOIN TRANSACTION_SUMMARY T
ON A.ACCOUNT_ID = T.ACCOUNT_ID;


COMMIT;
